  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "La grotte r\xE9serve d\xE9cid\xE9ment beaucoup de surprises aux aventuriers
    comme moi, j\u2019ai trouv\xE9 des champignons verts plus t\xF4t, ils contiennent
    un mat\xE9riau fluorescent que je n\u2019avais jamais vu jusque l\xE0, le lancer
    m\u2019a permit de m\u2019\xE9clairer un zone assez \xE9tendue. Cependant je
    ne me suis pas \xE9ternis\xE9 dans cette zone, un malaise m\u2019a rapidement
    envahi apr\xE8s quelques secondes dans sa lumi\xE8re."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9ccf0e26e5f7ea049a272ab97e70e0c9, type: 2}
  m_sharedMaterial: {fileID: 7860781554680187506, guid: 9ccf0e26e5f7ea049a272ab97e70e0c9, type: 2}
