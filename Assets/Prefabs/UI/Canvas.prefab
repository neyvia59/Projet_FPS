  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sortez-moi d\u2019ici je vous en supplie, cette grotte a l\u2019air de
    se nourrir de la lumi\xE8re, je viens de survivre \xE0 des plantes mangeuses
    d\u2019hommes ! Si j\u2019ai surv\xE9cu c\u2019est uniquement gr\xE2ce \xE0 ma
    lumi\xE8re, elles ont l\u2019air d\u2019en avoir peur, faites attention \xE0
    o\xF9 vous allez et \xE9clairez bien vos environs ou je ne donne pas cher de
    votre peau.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9ccf0e26e5f7ea049a272ab97e70e0c9, type: 2}
