  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Cette grotte me rend fou, j\u2019ai l\u2019impression d\u2019entendre
    d\u2019autres pas, d\u2019autres choses qui bougent tout autour de moi dans l\u2019obscurit\xE9.
    Je sais pas si les t\xE9n\xE8bres me rendent fou ou c\u2019est les champignons
    mais je suis presque sur d\u2019avoir entendu des bruits de bouche, mais qu\u2019est
    ce qui peut bien faire un tel bruit \xE0 un volume pareil ? Si vous cherchez
    le champignon rebroussez chemin je l\u2019ai s\xFBrement d\xE9j\xE0 trouv\xE9
    mais si vous cherchez \xE0 m\u2019aider faites vite je commence \xE0 avoir peur.\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9ccf0e26e5f7ea049a272ab97e70e0c9, type: 2}
  m_sharedMaterial: {fileID: 7860781554680187506, guid: 9ccf0e26e5f7ea049a272ab97e70e0c9, type: 2}
